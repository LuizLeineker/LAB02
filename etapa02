// =====================
// Jogo de Memória - 4 LEDs e 4 Botões
// =====================

const int numLeds = 4;

// LEDs
const int ledPins[numLeds] = {8, 9, 10, 11};

// Botões
const int buttonPins[numLeds] = {2, 3, 4, 5};

// Sequência
const int maxSequence = 50;
int sequence[maxSequence];
int level = 1;

// Tempo
int tempoLED = 400;
int tempoEntre = 200;

// =====================

void setup() {
  Serial.begin(9600);

  for (int i = 0; i < numLeds; i++) {
    pinMode(ledPins[i], OUTPUT);
    pinMode(buttonPins[i], INPUT_PULLUP);
  }

  randomSeed(analogRead(0));

  Serial.println("=== Jogo de Memoria (4 LEDs) ===");
}

// =====================

void loop() {
  gerarSequencia();
  mostrarSequencia();

  if (lerJogador()) {
    level++;
    Serial.print("✔ Nivel atual: ");
    Serial.println(level);
    delay(800);
  } else {
    erro();
    level = 1;
    delay(1000);
  }
}

// =====================

void gerarSequencia() {
  Serial.println("\nSequencia:");

  for (int i = 0; i < level; i++) {
    sequence[i] = random(0, numLeds);

    Serial.print(sequence[i]);
    Serial.print(" ");
  }
  Serial.println();
}

// =====================

void mostrarSequencia() {
  Serial.println("Mostrando...");

  for (int i = 0; i < level; i++) {
    int led = sequence[i];

    digitalWrite(ledPins[led], HIGH);
    delay(tempoLED);

    digitalWrite(ledPins[led], LOW);
    delay(tempoEntre);
  }
}

// =====================

bool lerJogador() {
  Serial.println("Repita a sequencia:");

  for (int i = 0; i < level; i++) {
    int botao = esperarBotao();

    Serial.print("Entrada: ");
    Serial.println(botao);

    // Feedback visual ao apertar
    digitalWrite(ledPins[botao], HIGH);
    delay(200);
    digitalWrite(ledPins[botao], LOW);

    if (botao != sequence[i]) {
      return false;
    }
  }

  return true;
}

// =====================

int esperarBotao() {
  while (true) {
    for (int i = 0; i < numLeds; i++) {
      if (digitalRead(buttonPins[i]) == LOW) {
        delay(200); // debounce

        while (digitalRead(buttonPins[i]) == LOW);

        return i;
      }
    }
  }
}

// =====================

void erro() {
  Serial.println("✖ Erro! Reiniciando...");

  for (int i = 0; i < 6; i++) {
    for (int j = 0; j < numLeds; j++) {
      digitalWrite(ledPins[j], HIGH);
    }
    delay(120);

    for (int j = 0; j < numLeds; j++) {
      digitalWrite(ledPins[j], LOW);
    }
    delay(120);
  }
}
